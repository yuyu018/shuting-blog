    box-shadow: 0 0 0 3px rgba(193,127,58,0.12);
  }
  .newsletter-input::placeholder { color: rgba(122,110,96,0.5); }
  .newsletter-submit {
    padding: 0.75rem 1.5rem;
    background: var(--amber);
