---
interface Props {
  label: string;
  titleHtml: string;
}
const { label, titleHtml } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero-bg"></div>
  <div class="page-hero-inner">
    <span class="section-label">{label}</span>
    <h1 class="page-hero-title" set:html={titleHtml} />
    <p class="page-hero-desc"><slot /></p>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding: 6rem 2rem 4rem;
    text-align: center;
  }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 60% at 50% 0%, rgba(232,168,76,0.1) 0%, transparent 60%),
      linear-gradient(160deg, #fdf8f2 0%, #f7ede0 50%, #faf5ec 100%);
  }
  .page-hero-inner {
    position: relative;
    max-width: 640px;
    margin: 0 auto;
  }
  .page-hero-title {
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.4;
    margin: 0.5rem 0 1.25rem;
    letter-spacing: 0.02em;
  }
  .page-hero-title :global(em) {
    font-style: normal;
    color: var(--amber);
    position: relative;
  }
  .page-hero-title :global(em)::after {
    content: '';
    position: absolute;
    bottom: 2px; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--amber-light), transparent);
    border-radius: 2px;
    opacity: 0.5;
  }
  .page-hero-desc {
    font-family: 'Noto Serif TC', serif;
    font-size: 1.05rem;
    color: var(--ink-muted);
    line-height: 2;
    font-weight: 300;
    margin: 0;
  }
</style>
